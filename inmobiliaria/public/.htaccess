# Para hosting Apache (cPanel, Hostinger, el hosting de WordPress, etc.). Netlify lo ignora.

# Abrir primero esta web (index.html) aunque queden archivos de WordPress (index.php)
DirectoryIndex index.html index.php

# Tipos de archivo
AddType image/webp .webp
AddType video/mp4 .mp4
AddType image/svg+xml .svg
AddType application/manifest+json .webmanifest

# Compresión de texto
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml
</IfModule>

# Caché: JS/CSS con hash 1 año; fotos, videos y fotogramas 1 día
<IfModule mod_headers.c>
  <FilesMatch "^.*-[A-Za-z0-9_-]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|jpg|png|mp4|svg)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
